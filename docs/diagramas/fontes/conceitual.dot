graph G {
  layout=neato; splines=line; pad=0.5; overlap=true;
  label="Diagrama Conceitual do Banco de Dados (notação de Chen)"; labelloc=t; fontsize=24; fontname="Helvetica";
  node [fontname="Helvetica", fontsize=12]; edge [fontname="Helvetica", fontsize=14, color="#37474F"];
  CLIENTE [shape=box, style="filled,bold", fillcolor="#CFE8E7", label="CLIENTE", fontsize=17, pos="0,0!", width=2.0, height=0.9];
  CLIENTE_ID_Cliente [shape=ellipse, label=<<U>ID_Cliente</U>>, style=filled, fillcolor=white, fontsize=11, pos="2.99,2.12!"];
  CLIENTE -- CLIENTE_ID_Cliente;
  CLIENTE_Nome [shape=ellipse, label="Nome", style=filled, fillcolor=white, fontsize=11, pos="1.62,3.00!"];
  CLIENTE -- CLIENTE_Nome;
  CLIENTE_CPF [shape=ellipse, label="CPF", style=filled, fillcolor=white, fontsize=11, pos="-0.06,3.30!"];
  CLIENTE -- CLIENTE_CPF;
  CLIENTE_Data_Nascimento [shape=ellipse, label="Data_Nascimento", style=filled, fillcolor=white, fontsize=11, pos="-1.73,2.96!"];
  CLIENTE -- CLIENTE_Data_Nascimento;
  CLIENTE_Telefone [shape=ellipse, label="Telefone", style=filled, fillcolor=white, fontsize=11, pos="-3.07,2.04!"];
  CLIENTE -- CLIENTE_Telefone;
  CLIENTE_Endereco [shape=ellipse, label="Endereco", style=filled, fillcolor=white, fontsize=11, pos="-3.80,0.73!"];
  CLIENTE -- CLIENTE_Endereco;
  CLIENTE_Bairro [shape=ellipse, label="Bairro", style=filled, fillcolor=white, fontsize=11, pos="-3.80,-0.73!"];
  CLIENTE -- CLIENTE_Bairro;
  CLIENTE_Cidade [shape=ellipse, label="Cidade", style=filled, fillcolor=white, fontsize=11, pos="-3.07,-2.04!"];
  CLIENTE -- CLIENTE_Cidade;
  CLIENTE_Estado [shape=ellipse, label="Estado", style=filled, fillcolor=white, fontsize=11, pos="-1.73,-2.96!"];
  CLIENTE -- CLIENTE_Estado;
  CLIENTE_CEP [shape=ellipse, label="CEP", style=filled, fillcolor=white, fontsize=11, pos="-0.06,-3.30!"];
  CLIENTE -- CLIENTE_CEP;
  CLIENTE_status [shape=ellipse, label="status", style=filled, fillcolor=white, fontsize=11, pos="1.62,-3.00!"];
  CLIENTE -- CLIENTE_status;
  CLIENTE_data_ultima_alteracao [shape=ellipse, label="data_ultima_alteracao", style=filled, fillcolor=white, fontsize=11, pos="2.99,-2.12!"];
  CLIENTE -- CLIENTE_data_ultima_alteracao;
  ANIMAL [shape=box, style="filled,bold", fillcolor="#FBE3B5", label="ANIMAL", fontsize=17, pos="12,0!", width=2.0, height=0.9];
  ANIMAL_ID_Animal [shape=ellipse, label=<<U>ID_Animal</U>>, style=filled, fillcolor=white, fontsize=11, pos="14.79,1.84!"];
  ANIMAL -- ANIMAL_ID_Animal;
  ANIMAL_Nome [shape=ellipse, label="Nome", style=filled, fillcolor=white, fontsize=11, pos="13.16,3.01!"];
  ANIMAL -- ANIMAL_Nome;
  ANIMAL_Data_Nascimento [shape=ellipse, label="Data_Nascimento", style=filled, fillcolor=white, fontsize=11, pos="10.84,3.01!"];
  ANIMAL -- ANIMAL_Data_Nascimento;
  ANIMAL_Sexo [shape=ellipse, label="Sexo", style=filled, fillcolor=white, fontsize=11, pos="9.21,1.84!"];
  ANIMAL -- ANIMAL_Sexo;
  ANIMAL_Cor [shape=ellipse, label="Cor", style=filled, fillcolor=white, fontsize=11, pos="9.21,-1.84!"];
  ANIMAL -- ANIMAL_Cor;
  ANIMAL_Observacoes [shape=ellipse, label="Observacoes", style=filled, fillcolor=white, fontsize=11, pos="13.16,-3.01!"];
  ANIMAL -- ANIMAL_Observacoes;
  ANIMAL_Status [shape=ellipse, label="Status", style=filled, fillcolor=white, fontsize=11, pos="14.79,-1.84!"];
  ANIMAL -- ANIMAL_Status;
  RACA [shape=box, style="filled,bold", fillcolor="#D5E1F3", label="RAÇA", fontsize=17, pos="24,0!", width=2.0, height=0.9];
  RACA_ID_Raca [shape=ellipse, label=<<U>ID_Raca</U>>, style=filled, fillcolor=white, fontsize=11, pos="22.65,2.54!"];
  RACA -- RACA_ID_Raca;
  RACA_Nome_Raca [shape=ellipse, label="Nome_Raca", style=filled, fillcolor=white, fontsize=11, pos="26.26,1.98!"];
  RACA -- RACA_Nome_Raca;
  RACA_Tipo_Animal [shape=ellipse, label="Tipo_Animal", style=filled, fillcolor=white, fontsize=11, pos="26.26,-1.98!"];
  RACA -- RACA_Tipo_Animal;
  RACA_Status [shape=ellipse, label="Status", style=filled, fillcolor=white, fontsize=11, pos="22.65,-2.54!"];
  RACA -- RACA_Status;
  possui [shape=diamond, style=filled, fillcolor="#FFF8E1", label="possui", pos="6,0!", width=1.9, height=1.1];
  classifica [shape=diamond, style=filled, fillcolor="#FFF8E1", label="é da raça", pos="18,0!", width=2.1, height=1.1];
  CLIENTE -- possui [label="(0,N)", penwidth=2, headlabel="", labelfloat=true];
  possui -- ANIMAL [label="(1,1)", penwidth=2];
  RACA -- classifica [label="(0,N)", penwidth=2];
  classifica -- ANIMAL [label="(1,1)", penwidth=2];
  legenda [shape=note, style=filled, fillcolor="#FFF8E1", pos="12,-5.2!", fontsize=12, label="Legenda: atributo sublinhado = identificador (chave).  Cardinalidade (mínimo,máximo).\nUm CLIENTE possui de 0 a N ANIMAIS; cada ANIMAL pertence a exatamente 1 CLIENTE.\nUma RAÇA classifica de 0 a N ANIMAIS; cada ANIMAL tem exatamente 1 RAÇA.\nCPF é único. Não pode haver a mesma raça duas vezes para o mesmo tipo (Cachorro/Gato).\nExclusão lógica: todas as entidades têm o atributo status (ativo/inativo)."];
}
