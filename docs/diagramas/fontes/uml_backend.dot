digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=20, labelloc=t, label="Diagrama de Classes UML - Backend (factory, modelo, dao, util)", nodesep=0.45, ranksep=0.9, splines=true, pad=0.4, bgcolor=white];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#37474F"];
  subgraph cluster_factory {
    label="pacote factory"; fontsize=14; fontname="Helvetica-Bold"; style="rounded,dashed"; color="#90A4AE"; 
      ConnectionFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>ConnectionFactory</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ARQUIVO_CONFIG: String {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getConnection(): Connection {static}<BR ALIGN="LEFT"/>+testarConexao(): boolean {static}<BR ALIGN="LEFT"/>+recarregarConfiguracao(): void {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_util {
    label="pacote util"; fontsize=14; fontname="Helvetica-Bold"; style="rounded,dashed"; color="#90A4AE"; 
      ValidadorCPF [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>ValidadorCPF</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+somenteDigitos(String): String {static}<BR ALIGN="LEFT"/>+isValido(String): boolean {static}<BR ALIGN="LEFT"/>+formatar(String): String {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
      CalculadoraIdade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>CalculadoraIdade</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+calcular(LocalDate, LocalDate): Period {static}<BR ALIGN="LEFT"/>+formatar(LocalDate): String {static}<BR ALIGN="LEFT"/>+formatar(LocalDate, LocalDate): String {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
      GeradorRelatorioTXT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>GeradorRelatorioTXT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+MESES: String[] {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+nomeMes(int): String {static}<BR ALIGN="LEFT"/>+gerarRelatorioGeral(Map, Path): Path {static}<BR ALIGN="LEFT"/>+gerarAniversariantesAnimais(int, List, Path): Path {static}<BR ALIGN="LEFT"/>+gerarAniversariantesClientes(int, List, Path): Path {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
      Validacao [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>Validacao</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+vazio(String): boolean {static}<BR ALIGN="LEFT"/>+limparOuNull(String): String {static}<BR ALIGN="LEFT"/>+excede(String, int): boolean {static}<BR ALIGN="LEFT"/>+padraoLike(String): String {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_dao {
    label="pacote dao"; fontsize=14; fontname="Helvetica-Bold"; style="rounded,dashed"; color="#90A4AE"; 
      ClienteDAO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>ClienteDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+inserir(Cliente): void<BR ALIGN="LEFT"/>+alterar(Cliente): void<BR ALIGN="LEFT"/>+desativar(int): void<BR ALIGN="LEFT"/>+reativar(int): void<BR ALIGN="LEFT"/>+buscarPorId(int): Cliente<BR ALIGN="LEFT"/>+buscarPorCpf(String): Cliente<BR ALIGN="LEFT"/>+listar(boolean): List&lt;Cliente&gt;<BR ALIGN="LEFT"/>+pesquisar(String, boolean): List&lt;Cliente&gt;<BR ALIGN="LEFT"/>+listarAniversariantesDoMes(int): List&lt;Cliente&gt;<BR ALIGN="LEFT"/>+contarAtivos(): int<BR ALIGN="LEFT"/>-validar(Cliente): void<BR ALIGN="LEFT"/>-verificarCpfDuplicado(String, int): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
      RacaDAO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>RacaDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+inserir(Raca): void<BR ALIGN="LEFT"/>+alterar(Raca): void<BR ALIGN="LEFT"/>+desativar(int): void<BR ALIGN="LEFT"/>+reativar(int): void<BR ALIGN="LEFT"/>+buscarPorId(int): Raca<BR ALIGN="LEFT"/>+listar(boolean): List&lt;Raca&gt;<BR ALIGN="LEFT"/>+pesquisar(String, boolean): List&lt;Raca&gt;<BR ALIGN="LEFT"/>+contarAtivas(): int<BR ALIGN="LEFT"/>-validar(Raca): void<BR ALIGN="LEFT"/>-verificarDuplicidade(String, String, int): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
      AnimalDAO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>AnimalDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+inserir(Animal): void<BR ALIGN="LEFT"/>+alterar(Animal): void<BR ALIGN="LEFT"/>+desativar(int): void<BR ALIGN="LEFT"/>+reativar(int): void<BR ALIGN="LEFT"/>+buscarPorId(int): Animal<BR ALIGN="LEFT"/>+listar(boolean): List&lt;Animal&gt;<BR ALIGN="LEFT"/>+pesquisar(String, boolean): List&lt;Animal&gt;<BR ALIGN="LEFT"/>+consultarPorCliente(String, String, boolean): List&lt;Animal&gt;<BR ALIGN="LEFT"/>+listarPorIdCliente(int): List&lt;Animal&gt;<BR ALIGN="LEFT"/>+listarAniversariantesDoMes(int): List&lt;Animal&gt;<BR ALIGN="LEFT"/>+contarAtivos(): int<BR ALIGN="LEFT"/>-validar(Animal): void<BR ALIGN="LEFT"/>-verificarClienteERaca(Animal): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
      DAOException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>DAOException</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+DAOException(String)<BR ALIGN="LEFT"/>+DAOException(String, Throwable)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
      RegraNegocioException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>RegraNegocioException</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+RegraNegocioException(String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  subgraph cluster_modelo {
    label="pacote modelo"; fontsize=14; fontname="Helvetica-Bold"; style="rounded,dashed"; color="#90A4AE"; 
      Cliente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>Cliente</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-int id<BR ALIGN="LEFT"/>-String nome<BR ALIGN="LEFT"/>-String cpf<BR ALIGN="LEFT"/>-LocalDate dataNascimento<BR ALIGN="LEFT"/>-String telefone<BR ALIGN="LEFT"/>-String endereco<BR ALIGN="LEFT"/>-String bairro<BR ALIGN="LEFT"/>-String cidade<BR ALIGN="LEFT"/>-String estado<BR ALIGN="LEFT"/>-String cep<BR ALIGN="LEFT"/>-boolean status<BR ALIGN="LEFT"/>-LocalDateTime dataUltimaAlteracao<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getters() / setters()<BR ALIGN="LEFT"/>+toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
      Raca [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>Raca</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+TIPO_CACHORRO: String {static}<BR ALIGN="LEFT"/>+TIPO_GATO: String {static}<BR ALIGN="LEFT"/>-int id<BR ALIGN="LEFT"/>-String nome<BR ALIGN="LEFT"/>-String tipoAnimal<BR ALIGN="LEFT"/>-boolean status<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getters() / setters()<BR ALIGN="LEFT"/>+toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
      Animal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F4F8FA"><TR><TD BGCOLOR="#D7E9EC" ALIGN="CENTER"><FONT POINT-SIZE="13"><B>Animal</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-int id<BR ALIGN="LEFT"/>-String nome<BR ALIGN="LEFT"/>-LocalDate dataNascimento<BR ALIGN="LEFT"/>-Character sexo<BR ALIGN="LEFT"/>-String cor<BR ALIGN="LEFT"/>-String observacoes<BR ALIGN="LEFT"/>-int idCliente<BR ALIGN="LEFT"/>-int idRaca<BR ALIGN="LEFT"/>-boolean status<BR ALIGN="LEFT"/>-String nomeCliente  (JOIN)<BR ALIGN="LEFT"/>-String cpfCliente  (JOIN)<BR ALIGN="LEFT"/>-String telefoneCliente  (JOIN)<BR ALIGN="LEFT"/>-String nomeRaca  (JOIN)<BR ALIGN="LEFT"/>-String tipoAnimal  (JOIN)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getters() / setters()<BR ALIGN="LEFT"/>+toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }
  Cliente -> Animal [dir=none, taillabel="1", headlabel="0..*", label="possui", labeldistance=2.2];
  Raca -> Animal [dir=none, taillabel="1", headlabel="0..*", label="classifica", labeldistance=2.2];
  ClienteDAO -> Cliente [style=dashed, arrowhead=vee, label="persiste"];
  RacaDAO -> Raca [style=dashed, arrowhead=vee, label="persiste"];
  AnimalDAO -> Animal [style=dashed, arrowhead=vee, label="persiste"];
  AnimalDAO -> ClienteDAO [arrowhead=vee, label="verifica cliente ativo"];
  AnimalDAO -> RacaDAO [arrowhead=vee, label="verifica raça ativa"];
  ClienteDAO -> ConnectionFactory [style=dashed, arrowhead=vee];
  RacaDAO -> ConnectionFactory [style=dashed, arrowhead=vee];
  AnimalDAO -> ConnectionFactory [style=dashed, arrowhead=vee];
  ClienteDAO -> ValidadorCPF [style=dashed, arrowhead=vee, label="valida CPF"];
  RegraNegocioException -> DAOException [arrowhead=empty, label="herda"];
  GeradorRelatorioTXT -> Cliente [style=dashed, arrowhead=vee, constraint=false];
  GeradorRelatorioTXT -> Animal [style=dashed, arrowhead=vee, constraint=false];
  nota [shape=note, style=filled, fillcolor="#FFF8E1", color="#BCA45A", label="Os três DAOs também usam util.Validacao\ne lançam DAOException / RegraNegocioException.\nA interface (pacote gui) só chama os DAOs.", fontsize=10];
}
