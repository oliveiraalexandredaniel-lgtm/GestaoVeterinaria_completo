digraph G {
  rankdir=LR; nodesep=0.8; ranksep=2.2; pad=0.4; bgcolor=white;
  label="Diagrama Lógico do Banco de Dados (MySQL)"; labelloc=t; fontsize=22; fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=11];
  cliente [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#CFE8E7"><B><FONT POINT-SIZE="14">cliente</FONT></B></TD></TR><TR><TD BGCOLOR="#ECEFF1"><B>Coluna</B></TD><TD BGCOLOR="#ECEFF1"><B>Tipo</B></TD><TD BGCOLOR="#ECEFF1"><B>Chave</B></TD><TD BGCOLOR="#ECEFF1"><B>Restrições</B></TD></TR><TR><TD ALIGN="LEFT"><B>ID_Cliente</B></TD><TD ALIGN="LEFT">INT</TD><TD>PK</TD><TD ALIGN="LEFT" PORT="pk">AUTO_INCREMENT</TD></TR><TR><TD ALIGN="LEFT">Nome</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD></TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT"><B>CPF</B></TD><TD ALIGN="LEFT">VARCHAR(14)</TD><TD>UK</TD><TD ALIGN="LEFT">NOT NULL, UNIQUE</TD></TR><TR><TD ALIGN="LEFT">Data_Nascimento</TD><TD ALIGN="LEFT">DATE</TD><TD></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">Telefone</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">Endereco</TD><TD ALIGN="LEFT">VARCHAR(150)</TD><TD></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">Bairro</TD><TD ALIGN="LEFT">VARCHAR(80)</TD><TD></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">Cidade</TD><TD ALIGN="LEFT">VARCHAR(80)</TD><TD></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">Estado</TD><TD ALIGN="LEFT">VARCHAR(2)</TD><TD></TD><TD ALIGN="LEFT">UF</TD></TR><TR><TD ALIGN="LEFT">CEP</TD><TD ALIGN="LEFT">VARCHAR(10)</TD><TD></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD></TD><TD ALIGN="LEFT">NOT NULL, DEFAULT TRUE</TD></TR><TR><TD ALIGN="LEFT">data_ultima_alteracao</TD><TD ALIGN="LEFT">DATETIME</TD><TD></TD><TD ALIGN="LEFT">NULL</TD></TR></TABLE>>];
  animal [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#FBE3B5"><B><FONT POINT-SIZE="14">animal</FONT></B></TD></TR><TR><TD BGCOLOR="#ECEFF1"><B>Coluna</B></TD><TD BGCOLOR="#ECEFF1"><B>Tipo</B></TD><TD BGCOLOR="#ECEFF1"><B>Chave</B></TD><TD BGCOLOR="#ECEFF1"><B>Restrições</B></TD></TR><TR><TD ALIGN="LEFT"><B>ID_Animal</B></TD><TD ALIGN="LEFT">INT</TD><TD>PK</TD><TD ALIGN="LEFT">AUTO_INCREMENT</TD></TR><TR><TD ALIGN="LEFT">Nome</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD></TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">Data_Nascimento</TD><TD ALIGN="LEFT">DATE</TD><TD></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">Sexo</TD><TD ALIGN="LEFT">CHAR(1)</TD><TD></TD><TD ALIGN="LEFT">CHECK (M ou F)</TD></TR><TR><TD ALIGN="LEFT">Cor</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">Observacoes</TD><TD ALIGN="LEFT">TEXT</TD><TD></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="fkc"><B>ID_Cliente</B></TD><TD ALIGN="LEFT">INT</TD><TD>FK</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="fkr"><B>ID_Raca</B></TD><TD ALIGN="LEFT">INT</TD><TD>FK</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">Status</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD></TD><TD ALIGN="LEFT">NOT NULL, DEFAULT TRUE</TD></TR></TABLE>>];
  raca [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#D5E1F3"><B><FONT POINT-SIZE="14">raca</FONT></B></TD></TR><TR><TD BGCOLOR="#ECEFF1"><B>Coluna</B></TD><TD BGCOLOR="#ECEFF1"><B>Tipo</B></TD><TD BGCOLOR="#ECEFF1"><B>Chave</B></TD><TD BGCOLOR="#ECEFF1"><B>Restrições</B></TD></TR><TR><TD ALIGN="LEFT"><B>ID_Raca</B></TD><TD ALIGN="LEFT">INT</TD><TD>PK</TD><TD ALIGN="LEFT" PORT="pk">AUTO_INCREMENT</TD></TR><TR><TD ALIGN="LEFT"><B>Nome_Raca</B></TD><TD ALIGN="LEFT">VARCHAR(80)</TD><TD>UK*</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT"><B>Tipo_Animal</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD>UK*</TD><TD ALIGN="LEFT">NOT NULL, CHECK (Cachorro ou Gato)</TD></TR><TR><TD ALIGN="LEFT">Status</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD></TD><TD ALIGN="LEFT">NOT NULL, DEFAULT TRUE</TD></TR></TABLE>>];
  cliente:pk:e -> animal:fkc:w [dir=both, arrowtail=tee, arrowhead=crow, label="  fk_animal_cliente  (1 : N)  "];
  raca:pk:e -> animal:fkr:w [dir=both, arrowtail=tee, arrowhead=crow, label="  fk_animal_raca  (1 : N)  "];
  nota [shape=note, style=filled, fillcolor="#FFF8E1", fontsize=11, label="PK = chave primária   FK = chave estrangeira   UK = única\nUK* = restrição única composta: UNIQUE (Nome_Raca, Tipo_Animal)\nÍndices: idx_cliente_nome, idx_animal_cliente, idx_animal_raca\nExclusão lógica: nenhuma linha é apagada, apenas status = FALSE"];
}
